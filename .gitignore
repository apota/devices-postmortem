## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Spec-driven workflow session files (ephemeral)
spec-driven/.sessions/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
*.binlog

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
.terraform.lock.hcl

/src/Solutions/.vs/Inventory.Api
.vs

# test files
coverage/
coveragereport/
TestResults/

# Spec-driven workflow session files (ephemeral)
spec-driven/.sessions/

# Claude Code settings (user-specific)
.claude/settings.local.json
.claude/settings.json

# temp decrypted SOPS files
.decrypted~*

# JetBrains Rider
.idea/
*.sln.iml

# Python development artifacts (virtual environments, caches, test artifacts)
# For comprehensive Python .gitignore patterns, see: https://github.com/github/gitignore/blob/main/Python.gitignore
.venv
__pycache__/
*.py[cod]
*$py.class
*.so

# pytest cache and coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Type checking and linting caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Python distribution / packaging
*.egg-info/
dist/
build/

.env

# Build cache files
*.lscache
